@startuml Pipeline
skinparam maxMessageSize 220

actor "Config (JSON / CLI)" as CFG
participant "main.run()" as MAIN
participant "Config scripts" as CO

participant "RegressionDataset\n(subclass)" as DS
participant "Regressor\n(concrete model)" as REG
participant "evaluate_regression" as EV

CFG -> MAIN : RunArguments

MAIN -> CO  : getDataset(args)
CO  -> DS  : <<create>> (synth / parkinsons / wine / protein / road / keggu)
DS  --> MAIN : dataset
MAIN -> DS  : get_data_splits(split, standardize, shuffle, seed)
DS  --> MAIN : (train, val, test), (y_mean, y_std), std_bools

MAIN -> CO  : getLikelihood(args)
CO  --> MAIN : likelihood (GaussianLikelihood)
MAIN -> CO  : getKernel(args, n_features)
CO  --> MAIN : kernel (RBF / Matern2.5 [Keops] +/- ScaleKernel)
MAIN -> CO  : getMean(args)
CO  --> MAIN : mean (ConstantMean)

MAIN -> CO : getGPModel(args, train, val, test, likelihood, kernel, mean)
CO -> REG  : <<create>> exact / exactcg / svgp / cagp
CO --> MAIN : model
MAIN -> CO  : getOptimizer(args, model)
CO  --> MAIN : optimizer (Adam / LBFGS)

MAIN -> MAIN : helpers.seed_check() / getResultFileDetails()

MAIN -> REG : run_training(optimizer, y_mean, y_std, std, iterations, logger)
REG -> REG : training loop
REG --> MAIN : training_duration

MAIN -> REG : predict(test[0])
REG --> MAIN : posterior, fit_time
MAIN -> EV  : evaluate_regression(...)
EV  --> MAIN : final metrics
MAIN -> MAIN : json.dump -> results/<dataset>/<model>/<timestamp>.json
@enduml
